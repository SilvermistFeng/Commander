# Postgres connection. Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://wandercraft:wandercraft@localhost:5432/wandercraft?schema=public"

# Secret used to sign login cookies. Change this to any long random string.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL, used when generating invite links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
